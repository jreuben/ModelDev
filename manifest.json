{
	"_version": "1.60.0",
	"sap.app": {
		"id": "modeldev",
		"type": "application",
		"i18n": {
			"bundleName": "modeldev.i18n.i18n",
			"supportedLocales": [""],
			"fallbackLocale": ""
		},
		"title": "{{appTitle}}",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "modeldev.view.App",
			"type": "XML",
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.108.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.f": {},
				"sap.ui.layout": {}
			}
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "modeldev.i18n.i18n",
					"supportedLocales": [""],
					"fallbackLocale": ""
				}
			}
		},
		"resources": {
			"css": [
				{ "uri": "css/style.css" }
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.f.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "modeldev.view",
				"controlId": "fcl",
				"transition": "slide",
				"async": true
			},
			"routes": [
				{
					"pattern": "",
					"name": "master",
					"target": ["master"]
				},
				{
					"pattern": "structure/{name}",
					"name": "detail",
					"target": ["master", "detail"]
				}
			],
			"targets": {
				"master": {
					"name": "Master",
					"id": "master",
					"controlAggregation": "beginColumnPages"
				},
				"detail": {
					"name": "Detail",
					"id": "detail",
					"controlAggregation": "midColumnPages"
				}
			}
		}
	}
}
